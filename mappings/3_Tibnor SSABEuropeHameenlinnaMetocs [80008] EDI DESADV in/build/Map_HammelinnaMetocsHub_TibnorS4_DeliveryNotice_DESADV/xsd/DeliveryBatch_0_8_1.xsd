<?xml version="1.0" encoding="UTF-8"?><xs:schema targetNamespace="http://www.ruukki.com/schemas/eai/rucomef/otc" elementFormDefault="qualified" attributeFormDefault="unqualified" xmlns="http://www.ruukki.com/schemas/eai/rucomef/otc" xmlns:altova="http://www.altova.com/xml-schema-extensions" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="Header">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="SchemaId">
					<xs:annotation>
						<xs:documentation>EDI: UNH.S009.0065 Name of the message</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="InternalMillOrder"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="SchemaVersion">
					<xs:annotation>
						<xs:documentation>EDI: UNH S009.0052 + S009.0054 Message version number</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="1.0"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="MessageFunction" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: BGM.1225 Defines if this message is original order or it&apos;s change or cancellation: 9 = original, 4 = Change, 1 = Cancellation.</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="1"/>
								<altova:example value="4"/>
								<altova:example value="9"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="DocumentType" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: BGM.1001 Defines if this message type: 105 = normal order, 224 = Rush Order</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="InterchangeSender" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: UNB.S002.0004 Technical identification, which partner has created this message. Usually OVT/EDI identifier.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="InterchangeRecipient" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: UNB.S003.0010 Technical identification, to which partner this message is targeted. Usually OVT/EDI identifier.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="MessageRoutingInbound" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation><![CDATA[This tag contains MQ queue references that are needed to determinate routing queues. Content can be created be the broker. Content will not be used by the receiving ERP system. Temporaty content, tag may be taken away on xslt parsing phases.]]></xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="MessageRoutingOutbound" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation><![CDATA[This tag contains MQ queue references that are needed to determinate routing queues. Content can be created be the broker. Content will not be used by the receiving ERP system. Temporaty content, tag may be taken away on xslt parsing phases.]]></xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="DeliveryBatch">
		<xs:annotation>
			<xs:documentation>DeliveryBatch contains information of order positions and goods delivered in one delivery</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:annotation>
					<xs:documentation>Customs duty applicable to third countries</xs:documentation>
				</xs:annotation>
				<xs:element ref="Header" minOccurs="0"/>
				<xs:element name="DeliveryBatchId" type="xs:string">
					<xs:annotation>
						<xs:documentation>Despatch Advice Identifier</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="SourceSystem">
					<xs:annotation>
						<xs:documentation>Name of source system. Examples: &quot;LAHTI&quot; &quot;LAJA&quot; &quot;METOCSHAP&quot; &quot;METOCSLA&quot; &quot;METOCSOL&quot; &quot;METOCSPU&quot; &quot;METOCSTO&quot; &quot;METOCSWS&quot; &quot;DEMA&quot;</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="MessageFunctionCode">
					<xs:annotation>
						<xs:documentation>Is the despatch new / updated / deleted in the legacy. Examples: &quot;NEW&quot; &quot;UPDATE&quot; &quot;DELETE&quot;</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="LanguageCodeIso" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Language of the text of the message</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="TransmissionTime" type="xs:string">
					<xs:annotation>
						<xs:documentation>Date and time when the message is sent</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="DespatchDate" type="xs:date">
					<xs:annotation>
						<xs:documentation>Date when the goods are leaving</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="DespatchTime" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Time when the goods are leaving</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="ArrivalDate" type="xs:date" minOccurs="0"/>
				<xs:element name="ArrivalTime" type="xs:string" minOccurs="0"/>
				<xs:element name="PickUpDate" type="xs:date" minOccurs="0"/>
				<xs:element name="PickUpTime" type="xs:string" minOccurs="0"/>
				<xs:element name="OrderDate" type="xs:date">
					<xs:annotation>
						<xs:documentation>Date when the order has been entered into legacy system</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="PurchaseOrder" type="xs:string">
					<xs:annotation>
						<xs:documentation>Order identifier in suppliers order entry system</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="ShipmentLotId" type="xs:string">
					<xs:annotation>
						<xs:documentation>Shipment lot number (part of DespatchAdviceId)</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="WayBillId" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Huom. tämä vain tilapäisesti; siirtyy Document rakenteeseen</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="InvoiceId" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Huom. tämä vain tilapäisesti; siirtyy Document rakenteeseen</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="DespatchDocument" type="DocumentDataType" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element name="Reference" type="ReferenceDataType" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element name="ConsignorParty" type="PartyType" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Consignor</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="BuyerParty" type="PartyType" minOccurs="0"/>
				<xs:element name="ConsigneeParty" type="PartyType" minOccurs="0"/>
				<xs:element name="ConsigneeAddress" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="AddressId" type="xs:integer"/>
							<xs:element name="DefaultType">
								<xs:simpleType>
									<xs:restriction base="xs:string"/>
								</xs:simpleType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="DeliveryParty" type="PartyType" minOccurs="0"/>
				<xs:element name="CarrierParty" type="PartyType" minOccurs="0"/>
				<xs:element name="ContactData" type="ContactDataType" minOccurs="0"/>
				<xs:element name="DeliveryTerms" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Terms of delivery</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="DeliveryTermsCode" type="xs:string" minOccurs="0"/>
							<xs:element name="DeliTermsCodeSetAgency" type="xs:string" minOccurs="0"/>
							<xs:element name="Destination" type="xs:string" minOccurs="0"/>
							<xs:element name="DeliveryTermsText" type="xs:string" minOccurs="0"/>
							<xs:element name="DeliveryTermsCountry" type="CountryType" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="ModeOfTransport" type="CodeType" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Mode of transportation</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="CountryOfDestination" type="CountryType" minOccurs="0"/>
				<xs:element name="PortOfLoading" type="CodeType" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element name="DeliveryBatchLine" minOccurs="0" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="DeliveryBatchLineId">
								<xs:annotation>
									<xs:documentation>Linenumber/position number of delivery batch</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:integer"/>
								</xs:simpleType>
							</xs:element>
							<xs:element name="ManufacturerParty" type="PartyType" minOccurs="0"/>
							<xs:element name="CustomersArticleId" type="xs:string" minOccurs="0">
								<xs:annotation>
									<xs:documentation>Customer&apos;s article identifier</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="CustomsTariffCode" minOccurs="0" maxOccurs="2">
								<xs:annotation>
									<xs:documentation>Customs tariff code</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:sequence>
										<xs:element name="CustomsTariffPlanned" type="xs:string"/>
										<xs:element name="CustomsTariffActual" type="xs:string" minOccurs="0"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="ProductGroup" type="CodeType" minOccurs="0">
								<xs:annotation>
									<xs:documentation>Product group</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="ProductCode" type="CodeType" minOccurs="0">
								<xs:annotation>
									<xs:documentation>Product identifier</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="GradeActual" type="CodeType" minOccurs="0"/>
							<xs:element name="Certificate" type="CodeType" minOccurs="0"/>
							<xs:element name="Protection" type="CodeType" minOccurs="0"/>
							<xs:element name="CoatingUpSide" type="CodeType" minOccurs="0"/>
							<xs:element name="CoatingBottomSide" type="CodeType" minOccurs="0"/>
							<xs:element name="ColourUpSide" type="CodeType" minOccurs="0"/>
							<xs:element name="ColourBottomSide" type="CodeType" minOccurs="0"/>
							<xs:element name="DeliveryNorm" type="CodeType" minOccurs="0"/>
							<xs:element name="Dimension" type="ValueType" minOccurs="0" maxOccurs="unbounded">
								<xs:annotation>
									<xs:documentation>Dimensions of position</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="DespatchedQuantity" type="ValueType" maxOccurs="unbounded"/>
							<xs:element name="CustomerMark" type="xs:string" minOccurs="0"/>
							<xs:element name="PartialDelivery" type="CodeType" minOccurs="0"/>
							<xs:element name="SinglePart" type="SinglePartType" minOccurs="0" maxOccurs="unbounded"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="PartyType">
		<xs:annotation>
			<xs:documentation>Structure of party data</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Identifier" minOccurs="0" maxOccurs="5">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="IdentifierCode" type="xs:string"/>
						<xs:element name="IdentifierCodeAgency" type="xs:string"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="NameOne" type="xs:string" minOccurs="0"/>
			<xs:element name="NameTwo" type="xs:string" minOccurs="0"/>
			<xs:element name="AddressOne" type="xs:string" minOccurs="0"/>
			<xs:element name="AddressTwo" type="xs:string" minOccurs="0"/>
			<xs:element name="AddressThree" type="xs:string" minOccurs="0"/>
			<xs:element name="PostCode" type="xs:string" minOccurs="0"/>
			<xs:element name="City" type="xs:string" minOccurs="0"/>
			<xs:element name="Country" type="CountryType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CountryType">
		<xs:annotation>
			<xs:documentation>Structure of country data</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CountryCodeIso" type="xs:string" minOccurs="0"/>
			<xs:element name="CountryName" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CodeType">
		<xs:annotation>
			<xs:documentation>Structure of data cocerning codes</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Code" type="xs:string" minOccurs="0"/>
			<xs:element name="CodeSetAgency" type="xs:string" minOccurs="0"/>
			<xs:element name="Text" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ValueType">
		<xs:annotation>
			<xs:documentation>Structure of data of values</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ValueName" minOccurs="0">
				<xs:annotation>
					<xs:documentation><![CDATA[Examples: "OuterDiameter" "Side1" "Side2" "Length" "Thickness" "Width" "BruttoWeight" "NetWeight" "GrossWeight" "Weight" "Meters" "SquareMeters" "Pieces" "TheoreticalWeight" "Bundles" "SquareMetersPrima" "SquareMetersTotal" "SquareMetersNotPrima" "WeighedWeight" "Packages" "NetWeightPrima"]]></xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Value" type="xs:string" minOccurs="0"/>
			<xs:element name="ValueUnit" type="xs:string" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SinglePartType">
		<xs:annotation>
			<xs:documentation>Structure of data of despatched single part</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SinglePartId" type="xs:string">
				<xs:annotation>
					<xs:documentation>Identifier of despatched article</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SinglePartType">
				<xs:annotation>
					<xs:documentation>Type of singlepart: bundle/single Examples: &quot;BUNDLE&quot; &quot;SINGLE&quot;</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:element>
			<xs:element name="SinglePartLevel" type="xs:integer">
				<xs:annotation>
					<xs:documentation>First level 1, next sublevel 2 etc</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Reference" type="ReferenceDataType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="Dimension" type="ValueType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="DespatchedQuantity" type="ValueType" maxOccurs="unbounded"/>
			<xs:element name="MaterialBatch" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="MaterialBatchId" type="xs:string">
							<xs:annotation>
								<xs:documentation>Identifier of material batch</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="MaterialBatchType" type="xs:string">
							<xs:annotation>
								<xs:documentation>Type of material batch: coil, heat, strip ... etc</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="Quantity" type="ValueType" minOccurs="0" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="SubSinglePart" type="SinglePartType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="ParentId" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CustomsDataType">
		<xs:sequence>
			<xs:element name="DeclarationMessageId"/>
			<xs:element name="DeclarationPermission">
				<xs:annotation>
					<xs:documentation>examples: &quot;AUTOMATIC&quot; &quot;MANUAL&quot; &quot;STOP&quot;</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:element>
			<xs:element name="MessageFunctionCode"/>
			<xs:element name="DeclarationPartyId"/>
			<xs:element name="ConsigneeCode"/>
			<xs:element name="ConsigneeCodeOrigin"/>
			<xs:element name="AdditionalDeclarationReference" minOccurs="0"/>
			<xs:element name="ExportCountry"/>
			<xs:element name="DeclarationDestinationCountry"/>
			<xs:element name="DepartureTransportVehicleId"/>
			<xs:element name="ContainerIndicator"/>
			<xs:element name="DeliveryTradeTerm"/>
			<xs:element name="BorderVehicleId"/>
			<xs:element name="BorderVehicleNationality"/>
			<xs:element name="TransactionNature"/>
			<xs:element name="BorderTransportMeans"/>
			<xs:element name="DepartureTransportMeans"/>
			<xs:element name="ClearanceLocation"/>
			<xs:element name="TotalGrossWeight"/>
			<xs:element name="CustomsProcedure"/>
			<xs:element name="PrinterId"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CustomsLineDataType">
		<xs:sequence>
			<xs:element name="GoodsLocationType"/>
			<xs:element name="GoodsLocation"/>
			<xs:element name="ContainerId"/>
			<xs:element name="PackageType"/>
			<xs:element name="CNText"/>
			<xs:element name="RowNumber"/>
			<xs:element name="CustomsStatValue"/>
			<xs:element name="CustomsStatValCurrency"/>
			<xs:element name="RoutingCountry"/>
			<xs:element name="FreightPaymentMethod"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DocumentDataType">
		<xs:sequence>
			<xs:element name="DocumentName">
				<xs:annotation>
					<xs:documentation>Examples: &quot;WayBill&quot; &quot;BilOfLading&quot; &quot;DespatchAdvice&quot; &quot;Invoice&quot; &quot;FreightNote&quot; &quot;Konossement&quot;</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:element>
			<xs:element name="DocumentType" type="xs:string" minOccurs="0"/>
			<xs:element name="DocumentId" type="xs:string"/>
			<xs:element name="DocumentDate" type="xs:date" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ReferenceDataType">
		<xs:sequence>
			<xs:element name="ReferenceType">
				<xs:annotation>
					<xs:documentation><![CDATA[Examples: "PurchaseOrder" "ShipmentLotId" "BuyersOrderId" "CustomerReference" "LoadId" "CargoId" "VehicleId" "TrailerId" "RailwayWagonId" "StemId" "NameOfShip" "ContainerId" "BilOfLading" "ServiceCenterOrder" "BundleId"]]></xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ReferenceId" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ContactDataType">
		<xs:sequence>
			<xs:element name="PartyType">
				<xs:annotation>
					<xs:documentation>Examples: &quot;Consignor&quot; &quot;Buyer&quot; &quot;Consignee&quot; &quot;Agent&quot; &quot;Custom&quot;</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Role" type="xs:string"/>
			<xs:element name="UserCode" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="UserId" type="xs:string"/>
						<xs:element name="SystemName" type="xs:string"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="PersonName" type="xs:string" minOccurs="0"/>
			<xs:element name="Communication" minOccurs="0" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="ModeCode">
							<xs:annotation>
								<xs:documentation>Examples: &quot;Email&quot; &quot;Phone&quot;</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:string"/>
							</xs:simpleType>
						</xs:element>
						<xs:element name="ConnectionId" type="xs:string"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
</xs:schema>