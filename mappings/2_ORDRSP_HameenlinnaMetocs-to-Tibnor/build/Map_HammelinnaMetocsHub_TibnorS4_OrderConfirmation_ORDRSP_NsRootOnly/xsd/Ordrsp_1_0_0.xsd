			<xs:attribute name="Type" use="required">
				<xs:annotation>
					<xs:documentation>EDI: ALC.5463
Allowance or charge type
A = allowance
C = charge</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
