									<xs:annotation>
										<xs:documentation>EDI: LOC.C517.3055
codeset issuer
91 = Assigned by Seller
92 = Assigned by Buyer
UN = UN/ECE (United Nations - Economic Commission for Europe)</xs:documentation>
									</xs:annotation>
