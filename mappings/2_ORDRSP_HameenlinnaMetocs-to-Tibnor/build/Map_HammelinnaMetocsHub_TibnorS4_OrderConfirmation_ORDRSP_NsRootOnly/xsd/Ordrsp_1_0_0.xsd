							<altova:example value="4"/>
						</altova:exampleValues>
					</xs:appinfo>
					<xs:documentation>EDI: TOD.4055
Terms of delivery function
4 = pick-up
6 = Delivery conditions</xs:documentation>
				</xs:annotation>
