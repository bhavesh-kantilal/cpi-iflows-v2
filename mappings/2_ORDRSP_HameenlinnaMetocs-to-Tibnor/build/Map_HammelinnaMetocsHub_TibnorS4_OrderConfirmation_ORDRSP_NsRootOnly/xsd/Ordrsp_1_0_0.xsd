						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Type">
				<xs:annotation>
					<xs:documentation>EDI: PCD.5245
Percentage type code
1 = Allowance
2 = Charge</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
