						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element ref="Location" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: TOD.LOC
Location information for terms of delivery</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="DeliverySchedule" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: SCC.4493
Delivery schedule
