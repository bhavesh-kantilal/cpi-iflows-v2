	<xs:element name="MeasurementSignificance">
		<xs:annotation>
			<xs:appinfo>
				<altova:exampleValues>
					<altova:example value="1"/>
					<altova:example value="2"/>
					<altova:example value="3"/>
				</altova:exampleValues>
			</xs:appinfo>
			<xs:documentation>EDI: MEA.C174.6432
