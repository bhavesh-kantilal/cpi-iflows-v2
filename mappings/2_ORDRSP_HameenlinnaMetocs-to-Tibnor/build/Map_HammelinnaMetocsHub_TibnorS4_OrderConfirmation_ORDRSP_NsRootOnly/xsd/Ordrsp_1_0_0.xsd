	<xs:element name="Percentage">
		<xs:annotation>
			<xs:documentation>EDI: PCD
Percentage value</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="PercentageValue">
					<xs:annotation>
						<xs:documentation>EDI: PCD.5482
Percentage value</xs:documentation>
					</xs:annotation>
