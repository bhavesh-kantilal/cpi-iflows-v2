						<xs:documentation>EDI: ALC.C214.7161
Allowance ot charge type
HD = Handling
PC = Packing
TO = Tooling</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element ref="MonetaryAmount" minOccurs="0"/>
				<xs:element ref="Tax" minOccurs="0"/>
				<xs:element name="AOCRateBasis" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: ALC.RTE</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="AOCRate" minOccurs="0">
								<xs:annotation>
									<xs:documentation>EDI: ALC.RTE.C128.5420
Amount for allowance or charge
(e.g. 30 EUR per TN -&gt; this is value 30)</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="AOCRateUnitOfMeasure" minOccurs="0">
								<xs:annotation>
									<xs:documentation>EDI: ALC.RTE.C128.6411
Unit for amount for allowance or charge
(e.g. 30 EUR per TN -&gt; this is value PT)</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
