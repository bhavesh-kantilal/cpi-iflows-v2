<?xml version="1.0" encoding="UTF-8"?><xs:schema elementFormDefault="qualified" xmlns:altova="http://www.altova.com/xml-schema-extensions" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	
	<xs:element name="OrdersMessage">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Header">
					<xs:annotation>
						<xs:documentation>General control data for this purchase order message. Metadata.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="DocumentId">
					<xs:annotation>
						<xs:documentation>Identification information for this purchase order.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="FreeText" minOccurs="0" maxOccurs="99">
					<xs:annotation>
						<xs:documentation><![CDATA[Free text data realting to purchase order's header level.
GEN = General text to order level.
PKG = Packaging text for order
PRD = Procustion/manufacturing instructions]]></xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="Reference" minOccurs="0" maxOccurs="10">
					<xs:annotation>
						<xs:documentation>EDI: RFF.C506.1154
References for purchase order&apos;s header level.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="Party" maxOccurs="99">
					<xs:annotation>
						<xs:documentation><![CDATA[EDI: NAD-segments
Purchaser order's partner information. 
Roles:
SE = Seller
BY = Buyer
IV = Invoicee
CN = Consignee
DP = Delivery party
UD = Ultimate customer
PF = Freight billable]]></xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="Currency" minOccurs="0"/>
				<xs:element ref="TermsOfPayment" minOccurs="0"/>
				<xs:element ref="ModeOfTransport" minOccurs="0"/>
				<xs:element ref="TermsOfDelivery" minOccurs="0" maxOccurs="2"/>
				<xs:element ref="Date" minOccurs="0" maxOccurs="35"/>
				<xs:element ref="Item" maxOccurs="999">
					<xs:annotation>
						<xs:documentation>EDI: LIN
Line items for purchase order</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="NumberOfLineItems">
					<xs:annotation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="1"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="18"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Header">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="SchemaId">
					<xs:annotation>
						<xs:documentation>EDI: UNH.S009.0065
Name of the message</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="InternalMillOrder"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="SchemaVersion">
					<xs:annotation>
						<xs:documentation>EDI: UNH S009.0052 + S009.0054
Message version number</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="1.0"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="MessageFunction">
					<xs:annotation>
						<xs:documentation>EDI: BGM.1225
Defines if this message is original order or it&apos;s change or cancellation: 9 = original, 4 = Change, 1 = Cancellation.</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="1"/>
								<altova:example value="4"/>
								<altova:example value="9"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="OrderType" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: BGM.1001
Defines if this message type: 105 = normal order, 
224 = Rush Order</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="InterchangeSender" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: UNB.S002.0004
Technical identification, which partner has created this message. Usually OVT/EDI identifier.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="InterchangeRecipient" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: UNB.S003.0010
Technical identification, to which partner this message is targeted. Usually OVT/EDI identifier.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="MessageRoutingInbound" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation><![CDATA[This tag contains MQ queue references that are needed to determinate routing queues. Content can be created be the broker. Content will not be used by the receiving ERP system. Temporaty content, tag may be taken away on xslt parsing phases.]]></xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="MessageRoutingOutbound" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation><![CDATA[This tag contains MQ queue references that are needed to determinate routing queues. Content can be created be the broker. Content will not be used by the receiving ERP system. Temporaty content, tag may be taken away on xslt parsing phases.]]></xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="DocumentId">
		<xs:annotation>
			<xs:documentation>EDI: BGM
Identification information</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="DocumentNo">
					<xs:annotation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="4500479588"/>
							</altova:exampleValues>
						</xs:appinfo>
						<xs:documentation>EDI: BGM.1004
Customer&apos;s purchase order number (e.g. SAP: 4500479588)</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element ref="Date" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: DTM.C507.2380 (2005 = &apos;4&apos;)
Purchase orders issue date. For DocumentID date is always in format &apos;102&apos; (YYYYMMDD).</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Party">
		<xs:annotation>
			<xs:documentation><![CDATA[EDI: NAD-segments
Purchaser order's partner information. 
Roles:
SE = Seller
BY = Buyer
IV = Invoicee
CN = Consignee
DP = Delivery party
UD = Ultimate customer
PF = Freight billable]]></xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="PartyId" nillable="1" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>EDI: NAD.C082.3039
Identification information for party.</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:simpleContent>
							<xs:extension base="xs:string">
								<xs:attribute name="Type">
									<xs:annotation>
										<xs:documentation>EDI: NAD.C082.1131
52 = VAT-code
100 = OVT code
167 = Tax Party Code
ZPL = Plant number/SAP
ZTI = TilkkuID
ZR3 = R/3-id/SAP
ZZZ = Mutually defined</xs:documentation>
										<xs:appinfo>
											<altova:exampleValues>
												<altova:example value="100"/>
											</altova:exampleValues>
										</xs:appinfo>
									</xs:annotation>
								</xs:attribute>
							</xs:extension>
						</xs:simpleContent>
					</xs:complexType>
				</xs:element>
				<xs:element name="PartyName1" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.C080.3036
Party Name part1</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="Ruukki Metals OY"/>
								<altova:example value="Presteel Oy"/>
								<altova:example value="Martensson Stål AB"/>
								<altova:example value="DKW International Ltd."/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="PartyName2" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.C080.3036
Party Name part2</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="c/o Anderseen project"/>
								<altova:example value="Tuotevarasto ovi A2"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="PartyName3" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.C080.3036
Party Name part3</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="party name 3"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="PartyName4" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.C080.3036
Party Name part4</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="Party Name 4"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="PartyName5" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.C080.3036
Party Name part5</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="Party Name 5"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="AddressLine1" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.C059.3042
Street or P.O. Box irformation row1.</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="PL 123"/>
								<altova:example value="Rautarukintie 155"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="AddressLine2" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.C059.3042
Street or P.O. Box irformation row2.</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="E-48100 MUNGUIA/VIZCAYA"/>
								<altova:example value=""/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="AddressLine3" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.C059.3042
Street or P.O. Box irformation row3.</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="address line 3"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="AddressLine4" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.C059.3042
Street or P.O. Box irformation row4.</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="address line 4"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="City" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.3164
Party&apos;s City name</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="Raahe"/>
								<altova:example value="Hämeenlinna"/>
								<altova:example value="London"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="PostalCode" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.3251
Zip code for party&apos;s address</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="PL 93"/>
								<altova:example value="P.O. Box 123"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="CountryCode" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.3207
Country code for party. Always ISO3166 coded format.</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="FI"/>
								<altova:example value="US"/>
								<altova:example value="SE"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element ref="Contact" minOccurs="0" maxOccurs="5"/>
			</xs:sequence>
			<xs:attribute name="Role">
				<xs:annotation>
					<xs:documentation>EDI: NAD.3035
Partys role for purchase order
BY = Buyer
SE = Seller
IV = Invoicee
UD = EndUser
MF = Manufacturer</xs:documentation>
					<xs:appinfo>
						<altova:exampleValues>
							<altova:example value="SE"/>
							<altova:example value="BY"/>
							<altova:example value="IV"/>
							<altova:example value="DP"/>
							<altova:example value="CN"/>
							<altova:example value="UD"/>
							<altova:example value="PF"/>
						</altova:exampleValues>
					</xs:appinfo>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="Contact">
		<xs:annotation>
			<xs:documentation>EDI: NAD.CTA
Party related contact persons</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ContactId" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.CTA.C056.3413
Contact person&apos;s identification code (assigned by buyer) e.g. HR-number, department code</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="100"/>
								<altova:example value="X007"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="ContactName" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.CTA.C056.3412
Contact person&apos;s name</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="Olli ostaja"/>
								<altova:example value="James Hilton"/>
								<altova:example value="Zao Ling Young"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="CommId" nillable="1" minOccurs="0" maxOccurs="5">
					<xs:annotation>
						<xs:documentation>EDI: NAD.CTA.COM.C076.3148
Contact persons communication information</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="olli.ostaja@company.com"/>
								<altova:example value="+358401234565432"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:complexType>
						<xs:simpleContent>
							<xs:extension base="xs:string">
								<xs:attribute name="Type">
									<xs:annotation>
										<xs:documentation>EDI: NAD.CTA.COM.C076.3155
TE = Telephone
FX = Fax
EM = email</xs:documentation>
										<xs:appinfo>
											<altova:exampleValues>
												<altova:example value="EM"/>
												<altova:example value="TE"/>
											</altova:exampleValues>
										</xs:appinfo>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string"/>
									</xs:simpleType>
								</xs:attribute>
							</xs:extension>
						</xs:simpleContent>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Type">
				<xs:annotation>
					<xs:appinfo>
						<altova:exampleValues>
							<altova:example value="SR"/>
							<altova:example value="PD"/>
							<altova:example value="TR"/>
						</altova:exampleValues>
					</xs:appinfo>
					<xs:documentation>EDI: NAD.CTA.3139
SR = Sales representative
PD = Purchasing contact
TR = Transport contact</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="TermsOfPayment">
		<xs:annotation>
			<xs:documentation>EDI: PAT
Terms of payment</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="TermsOfPaymentCode" nillable="1" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: PAT.C110.4277
Terms of payment in coded format, as code</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="30"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:complexType>
						<xs:simpleContent>
							<xs:extension base="xs:string">
								<xs:attribute name="CodeSet">
									<xs:annotation>
										<xs:documentation>EDI: PAT.C110.3055
Code set issuer:
92 = Assigned by buyer
91 = Assigned by seller</xs:documentation>
										<xs:appinfo>
											<altova:exampleValues>
												<altova:example value="91"/>
											</altova:exampleValues>
										</xs:appinfo>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string"/>
									</xs:simpleType>
								</xs:attribute>
							</xs:extension>
						</xs:simpleContent>
					</xs:complexType>
				</xs:element>
				<xs:element name="TermsOfPaymentText" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: PAT.C110.4276 (both lines concatenated)
Payment terms text</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="30 days from date of invoice"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Type">
				<xs:annotation>
					<xs:appinfo>
						<altova:exampleValues>
							<altova:example value="1"/>
						</altova:exampleValues>
					</xs:appinfo>
					<xs:documentation>EDI: PAT.4279
1 = Basic</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="ModeOfTransport">
		<xs:annotation>
			<xs:documentation>EDI: TDT
Buyers requirements for good&apos;s transportation.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ModeOfTransportCode" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: TDT.C220.8067
Mode of transport code (coded according to UN/ECE Recomm 19)
1 = Maritime
2 = Rail
3 = Road</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="3"/>
								<altova:example value="1"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
				</xs:element>
				<xs:element name="ModeOfTransportText" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: TDT.C220.8066
Mode of delivery as text.</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="By Train"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Type">
				<xs:annotation>
					<xs:documentation>EDI: TDT.8051
Transport stage qualifier.
20 = main carriage
30 = On-carriage</xs:documentation>
					<xs:appinfo>
						<altova:exampleValues>
							<altova:example value="20"/>
						</altova:exampleValues>
					</xs:appinfo>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="TermsOfDelivery">
		<xs:annotation>
