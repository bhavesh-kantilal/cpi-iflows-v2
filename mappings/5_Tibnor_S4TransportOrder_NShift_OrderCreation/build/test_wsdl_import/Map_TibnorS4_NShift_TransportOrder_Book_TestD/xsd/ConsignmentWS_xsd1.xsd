<?xml version='1.0' encoding='UTF-8'?><!-- Published by JAX-WS RI (https://github.com/eclipse-ee4j/metro-jax-ws). RI's version is Eclipse Metro/2.4.7 (RELEASE-2.4.7-1ccd54b; 2021-10-15T10:09:37+0000) JAXWS-RI/2.3.5 JAXWS-API/2.3.3 JAXB-RI/2.3.5 JAXB-API/2.3.3 git-revision#1ccd54b. --><xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.spedpoint.com/consignment/types/v1_0" targetNamespace="http://www.spedpoint.com/consignment/types/v1_0">

	<xsd:complexType name="ConsignmentList">
		<xsd:sequence>
			<xsd:element name="Consignment" type="tns:Consignment" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="Consignment">
		<xsd:sequence>
			<xsd:element name="Part" type="tns:Part" maxOccurs="unbounded"/>
			<xsd:element name="GoodsItem" type="tns:GoodsItem" maxOccurs="unbounded"/>
			<xsd:element name="TransportProduct" type="tns:TransportProduct"/>
			<xsd:element name="Target" type="tns:Target" minOccurs="0" maxOccurs="1"/>
			<xsd:element name="Contents" type="tns:Contents" minOccurs="0" maxOccurs="1"/>
			<xsd:element name="GoodsGroup" type="tns:GoodsGroup" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element name="ConsignmentReference" type="tns:ConsignmentReference" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element name="Note" type="tns:Note" minOccurs="0" maxOccurs="unbounded"/>
			<xsd:element name="GoodsInvoice" type="tns:GoodsInvoice" minOccurs="0" maxOccurs="1"/>
		</xsd:sequence>
		<xsd:attribute name="orderNo" type="xsd:string" use="required"/>
		<xsd:attribute name="orderType" type="xsd:string" use="optional"/>
		<xsd:attribute name="automaticBooking" type="xsd:string" use="optional"/>
		<xsd:attribute name="consignmentId" type="xsd:string" use="optional"/>
		<xsd:attribute name="consignmentNo" type="xsd:string" use="optional"/>
		<xsd:attribute name="templateName" type="xsd:string" use="optional"/>
		<xsd:attribute name="owner" type="xsd:string" use="optional"/>
	</xsd:complexType>

		<xsd:complexType name="Part">
			<xsd:sequence>
				<xsd:element name="Address" type="tns:Address"/>
				<xsd:element name="Communication" type="tns:Communication" minOccurs="0" maxOccurs="1"/>
				<xsd:element name="Reference" type="tns:Reference" minOccurs="0" maxOccurs="1"/>
			</xsd:sequence>
            <xsd:attribute name="role" use="required">
                <xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:enumeration value="consignor"/>
						<xsd:enumeration value="pickupAddress"/>
						<xsd:enumeration value="consignee"/>
						<xsd:enumeration value="deliveryAddress"/>
						<xsd:enumeration value="payer"/>
						<xsd:enumeration value="notify"/>
						<xsd:enumeration value="buyer"/>
						<xsd:enumeration value="seller"/>
						<xsd:enumeration value="deliveryTerminal"/>
						<xsd:enumeration value="returnAddress"/>
						<xsd:enumeration value="orderingCustomer"/>
						<xsd:enumeration value="receivingAgent"/>
						<xsd:enumeration value="customsVATPayer"/>
						<xsd:enumeration value="extranotify"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:attribute>
			<xsd:attribute name="account" type="xsd:string" use="optional"/>
		</xsd:complexType>

		<xsd:complexType name="Address">
			<xsd:sequence>
				<xsd:element ref="tns:id" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:name" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:address" maxOccurs="unbounded"/>
				<xsd:element ref="tns:postcode" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:city" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:state" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:countrycode" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:posX" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:posY" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:posSystem" minOccurs="0" maxOccurs="1"/>
			</xsd:sequence>
		</xsd:complexType>

		<xsd:complexType name="Communication">
			<xsd:sequence>
				<xsd:element ref="tns:contactPerson" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:phone" minOccurs="0" maxOccurs="1"/>
				<xsd:element name="mobile" type="tns:mobile" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:fax" minOccurs="0" maxOccurs="1"/>
				<xsd:element name="email" type="tns:email" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:bankgiro" minOccurs="0" maxOccurs="1"/>
			</xsd:sequence>
		</xsd:complexType>

		<xsd:complexType name="Reference">
			<xsd:sequence>
				<xsd:element ref="tns:customerNo" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:reference" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:accountNo" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:eanCustomerNo" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:palletRegNo" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:vatNo" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:eoriNo" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:einNo" minOccurs="0" maxOccurs="1"/>
			</xsd:sequence>
		</xsd:complexType>

		<xsd:complexType name="ConsignmentReference">
			<xsd:sequence>
				<xsd:element ref="tns:value"/>
			</xsd:sequence>
			<xsd:attribute name="type" type="xsd:string" use="optional"/>
		</xsd:complexType>

		<xsd:complexType name="GoodsGroup">
			<xsd:sequence>
				<xsd:element name="GoodsGroupItem" type="tns:GoodsGroupItem" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
			<xsd:attribute name="name" type="xsd:string" use="optional"/>
		</xsd:complexType>

		<xsd:complexType name="GoodsGroupItem">
			<xsd:sequence>
				<xsd:element name="ContentItem" type="tns:ContentItem" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element name="GoodsItem" type="tns:GoodsItem" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>

		<xsd:complexType name="GoodsItem">
			<xsd:sequence>
				<xsd:element ref="tns:noOfPackages" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:weight" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:volume" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:length" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:width" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:height" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:loadingMetres" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:palletSpace" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:packageType" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:tag" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:goodsType" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:netWeight" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:weightUnit" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:volumeUnit" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:lengthUnit" minOccurs="0" maxOccurs="1"/>
                <xsd:element ref="tns:stackable" minOccurs="0" maxOccurs="1"/>
                <xsd:element ref="tns:notes" minOccurs="0" maxOccurs="1"/>
                <xsd:element ref="tns:freightClass" minOccurs="0" maxOccurs="1"/>
				<xsd:element name="PackageIds" type="tns:PackageIds" minOccurs="0" maxOccurs="1"/>
				<xsd:element name="DangerousGoods" type="tns:DangerousGoods" minOccurs="0" maxOccurs="1"/>
			</xsd:sequence>
		</xsd:complexType>

		<xsd:complexType name="PackageIds">
			<xsd:sequence>
				<xsd:element ref="tns:code" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>


		<xsd:complexType name="DangerousGoods">
			<xsd:sequence>
				<xsd:element ref="tns:unNo" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:adrClass" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:packGroup" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:weight" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:netWeight" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:netWeightExplSub" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:noOfPackages" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:packageType" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:mp" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:flamePoint" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:lq" minOccurs="0" maxOccurs="1"/>
				<xsd:element name="Category" type="tns:Category" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:ems" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:sp" minOccurs="0" maxOccurs="1"/>
                <xsd:element ref="tns:tunnelRestrictionCode" minOccurs="0" maxOccurs="1"/>
                <xsd:element ref="tns:description" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="tns:liquidQuantityLitres" minOccurs="0" maxOccurs="1"/>
			</xsd:sequence>
		</xsd:complexType>


		<xsd:complexType name="Category">
			<xsd:attribute name="value" use="required">
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:enumeration value="0"/>
						<xsd:enumeration value="1"/>
						<xsd:enumeration value="2"/>
						<xsd:enumeration value="3"/>
						<xsd:enumeration value="4"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:attribute>
		</xsd:complexType>

		<xsd:complexType name="TransportProduct">
			<xsd:sequence>
				<xsd:element ref="tns:mode" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:code" minOccurs="0" maxOccurs="1"/>
                <xsd:element name="PaymentInstruction" type="tns:PaymentInstruction" minOccurs="0" maxOccurs="1"/>
                <xsd:element name="AddService" type="tns:AddService" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="tns:advice" minOccurs="0" maxOccurs="1"/>
				<xsd:element name="Tod" type="tns:Tod" minOccurs="0" maxOccurs="1"/>
				<xsd:element name="Cod" type="tns:Cod" minOccurs="0" maxOccurs="1"/>
				<xsd:element name="Pickup" type="tns:Pickup" minOccurs="0" maxOccurs="1"/>
				<xsd:element name="Delivery" type="tns:Delivery" minOccurs="0" maxOccurs="1"/>
				<xsd:element name="Transport" type="tns:Transport" minOccurs="0" maxOccurs="1"/>
				<xsd:element name="CustomsClearance" type="tns:CustomsClearance" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element name="Sortcode" type="tns:Sortcode" minOccurs="0" maxOccurs="1"/>
				<xsd:element name="Insurance" type="tns:Insurance" minOccurs="0" maxOccurs="1"/>
                <xsd:element name="ServiceOption" type="tns:ServiceOption" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>

		<xsd:complexType name="Target">
			<xsd:sequence>
				<xsd:element ref="tns:date"/>
				<xsd:element ref="tns:earliest" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:latest" minOccurs="0" maxOccurs="1"/>
			</xsd:sequence>
		</xsd:complexType>

		<xsd:complexType name="Contents">
			<xsd:sequence>
				<xsd:element name="ContentItem" type="tns:ContentItem" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>

		<xsd:complexType name="ContentItem">
			<xsd:sequence>
				<xsd:element ref="tns:noOfOrderedItems" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:noOfDeliveredItems" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:articleNo" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:orderNo" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:productName" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:productAttribute" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="tns:weight" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:volume" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:length" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:width" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:height" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:price" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:currency" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:packageType" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:location" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:notes" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:itemId" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:partNo" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:companyNo" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:warehouseId" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:statisticalNo" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:netWeight" minOccurs="0" maxOccurs="1"/>
			</xsd:sequence>
		</xsd:complexType>

		<xsd:complexType name="GoodsInvoice">
			<xsd:sequence>
				<xsd:element ref="tns:invoiceNo" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:invoiceDate" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:orderNo" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:termsOfPayment" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:discount" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:freightCost" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:currency" minOccurs="0" maxOccurs="1"/>
				<xsd:element name="InvoiceNote" type="tns:InvoiceNote" minOccurs="0" maxOccurs="unbounded"/>
                <xsd:element ref="tns:totalVATAmount" minOccurs="0" maxOccurs="1"/>
			</xsd:sequence>
		</xsd:complexType>

		<xsd:complexType name="InvoiceNote">
			<xsd:sequence>
				<xsd:element ref="tns:value"/>
			</xsd:sequence>
			<xsd:attribute name="type" type="xsd:string" use="optional"/>
		</xsd:complexType>

		<xsd:complexType name="Note">
			<xsd:sequence>
				<xsd:element ref="tns:value"/>
			</xsd:sequence>
			<xsd:attribute name="type" type="xsd:string" use="optional"/>
		</xsd:complexType>

		<xsd:complexType name="PaymentInstruction">
            <xsd:attribute name="value" use="optional">
            <xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:enumeration value="P"/>
						<xsd:enumeration value="C"/>
						<xsd:enumeration value="T"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:attribute>
		</xsd:complexType>

		<xsd:complexType name="AddService">
			<xsd:attribute name="name" type="xsd:string" use="optional"/>
			<xsd:attribute name="value" type="xsd:string"/>
		</xsd:complexType>

		<xsd:complexType name="Tod">
			<xsd:sequence>
				<xsd:element ref="tns:combiterm"/>
				<xsd:element ref="tns:location"/>
				<xsd:element ref="tns:countrycode" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:notes" minOccurs="0" maxOccurs="1"/>
			</xsd:sequence>
		</xsd:complexType>

		<xsd:complexType name="Cod">
			<xsd:sequence>
				<xsd:element ref="tns:amount"/>
				<xsd:element ref="tns:currency"/>
				<xsd:element ref="tns:paymentMethod"/>
				<xsd:element ref="tns:accountNo" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:reference" minOccurs="0" maxOccurs="1"/>
                <xsd:element ref="tns:referenceType" minOccurs="0" maxOccurs="1"/>
            </xsd:sequence>
		</xsd:complexType>


		<xsd:complexType name="Pickup">
			<xsd:sequence>
				<xsd:element ref="tns:date" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:earliest" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:latest" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:instruction" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:element ref="tns:location" minOccurs="0" maxOccurs="1"/>
			</xsd:sequence>
		</xsd:complexType>


		<xsd:complexType name="Delivery">
			<xsd:sequence>
				<xsd:element ref="tns:date" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:earliest" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:latest" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:instruction" minOccurs="0" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>

		<xsd:complexType name="Transport">
			<xsd:sequence>
				<xsd:element ref="tns:instruction" minOccurs="0" maxOccurs="unbounded"/>
				<xsd:choice minOccurs="0" maxOccurs="1">
					<xsd:element ref="tns:cooling"/>
					<xsd:element ref="tns:heating"/>
					<xsd:element ref="tns:frozen"/>
				</xsd:choice>
				<xsd:element ref="tns:tempLow" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:tempHigh" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:subsidyNo" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:valuableGoods" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:carryIn" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:extraCrew" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:eurPallets" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:limitedQuantityDangerousGoods" minOccurs="0" maxOccurs="1"/>
			</xsd:sequence>
		</xsd:complexType>

		<xsd:complexType name="CustomsClearance">
			<xsd:sequence>
				<xsd:element ref="tns:customsDeclarationNo" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:customsDescription" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:customsReference" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:countryOfOrigin" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:invoiceNo" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:invoiceDate" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:goodsValue" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:goodsValueCurrency" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:statisticalNo" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:dutiable" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:documentType" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:goodsType" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:goodsDescription" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:netWeight" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:numberOfGoodsItems" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:positionInCompany" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:priceRemarks" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:weightUnit" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:reason" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:unitOfMeasureCode" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:unitPrice" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:grossWeight" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:movementReferenceNo" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:eudrDdsReferenceNo" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:eudrTaricDocumentCode" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:manufacturerProductId" minOccurs="0" maxOccurs="1"/>
				<xsd:element ref="tns:standardisedProductId" minOccurs="0" maxOccurs="1"/>
            </xsd:sequence>
		</xsd:complexType>

		<xsd:complexType name="Sortcode">
			<xsd:sequence>
				<xsd:element ref="tns:code"/>
				<xsd:element ref="tns:quantity"/>
			</xsd:sequence>
		</xsd:complexType>

		<xsd:complexType name="Insurance">
			<xsd:sequence>
				<xsd:element ref="tns:amount"/>
				<xsd:element ref="tns:currency"/>
			</xsd:sequence>
		</xsd:complexType>

		<xsd:complexType name="email">
			<xsd:simpleContent>
				<xsd:extension base="xsd:string">
					<xsd:attribute name="notify" type="xsd:boolean" use="optional"/>
				</xsd:extension>
			</xsd:simpleContent>
  		</xsd:complexType>

		<xsd:complexType name="mobile">
			<xsd:simpleContent>
				<xsd:extension base="xsd:string">
					<xsd:attribute name="notify" type="xsd:boolean" use="optional"/>
				</xsd:extension>
			</xsd:simpleContent>
  		</xsd:complexType>

    <xsd:complexType name="ServiceOption">
        <xsd:sequence>
            <xsd:element name="ServiceOptionItem" type="tns:ServiceOptionItem" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
        <xsd:attribute name="value" type="xsd:string" use="optional"/>
        <xsd:attribute name="type" use="required" type="xsd:string"/>
    </xsd:complexType>

    <xsd:complexType name="ServiceOptionItem">
        <xsd:attribute name="type" use="required" type="xsd:string"/>
        <xsd:attribute name="value" use="optional" type="xsd:string"/>
    </xsd:complexType>

	<xsd:element name="id" type="xsd:string">
 </xsd:element>
	<xsd:element name="name" type="xsd:string">
 </xsd:element>
	<xsd:element name="address" type="xsd:string">
 </xsd:element>
	<xsd:element name="postcode" type="xsd:string">
 </xsd:element>
	<xsd:element name="city" type="xsd:string">
 </xsd:element>
	<xsd:element name="state" type="xsd:string">
 </xsd:element>
	<xsd:element name="countrycode" type="xsd:string">
 </xsd:element>
