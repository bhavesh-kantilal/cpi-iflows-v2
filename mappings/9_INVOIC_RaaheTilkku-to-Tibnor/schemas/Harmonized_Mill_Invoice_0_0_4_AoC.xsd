		</xs:simpleType>
	</xs:element>
	<xs:element name="PropertyText">
		<xs:annotation>
			<xs:documentation>EDI: IMD.C273.7008 (both fields concatenated) Testual description for property</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="QuantityValue">
		<xs:annotation>
			<xs:documentation>EDI: QTY.C186.6060 Quantity value</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="TermsOfDeliveryText">
		<xs:annotation>
			<xs:documentation>EDI: TOD.C100.4052 (both fields concatenated) Terms of delivery in text format</xs:documentation>
			<xs:appinfo>
				<altova:exampleValues>
					<altova:example value="Unloading on customer&apos;s account"/>
					<altova:example value="Perilletoimitettuna"/>
				</altova:exampleValues>
			</xs:appinfo>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="TypeOfShipment">
		<xs:complexType mixed="true"/>
	</xs:element>
	<xs:element name="UpperTolerance">
		<xs:simpleType>
			<xs:restriction base="xs:string"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="LanguageCode">
		<xs:annotation>
			<xs:documentation>EDI: FTX.3453 Language code as code, according to standard ISO 639</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="BankAccount">
		<xs:annotation>
			<xs:documentation>EDI: FII Pay-to&apos;s financial institution</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="BankAccountNumber" type="xs:string">
					<xs:annotation>
						<xs:documentation>EDI: FII.C078.3194 Bank account number (i.e: SE6250000000058151014539)</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="AccountHolderName" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: FII.C078.3192 (i.e: OKOYFIHH)</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="InstitutionName" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: FII.C088.3432 Name of the bank where the account is opened (i.e: POHJOLA PANKKI OY).</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="InstitutionBranchLocation" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: FII.C088.3436 Institution branch location name</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Role" use="required">
				<xs:annotation>
					<xs:documentation>EDI: NAD.FII.3035 Bank Account role: BF = Beneficiary&apos;s bank (primary account) B1 = Contact bank 1 B2 = Contact bank 2</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="CountryCode" type="xs:string">
		<xs:annotation>
			<xs:documentation>EDI: 3207 Country code. Always ISO3166 coded format.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="DeliveryStatus">
		<xs:annotation>
			<xs:documentation>EDI: QVR</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="DeliveryStatusCode" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: QVR.4221 CC = Shipment complete LS = Last shipment BP = Partial shipment</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="DeliveryStatusText" type="xs:string" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="MonetaryAmount">
		<xs:annotation>
			<xs:documentation>EDI: MOA Monetary amounts</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="MonetaryValue">
					<xs:annotation>
						<xs:documentation>EDI: MOA.C516.5004 Value of amount in currency units.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="Currency"/>
			</xs:sequence>
			<xs:attribute name="Type" use="required">
				<xs:annotation>
					<xs:documentation><![CDATA[EDI: MOA.C516.5025 Monetary amount type 38 = The line item amount is the total related to this line item (price * quantity). It excludes rebates, additions and VAT 79 = Total line items amount 176 = Message total tax amount 124 = Tax amount (line level) 165 = Adjustment amount total 125 = Taxable amount total 8 = Allowance or charge amount 39 = Invoice total amount (is the sum of: line item amounts (Qualifier 79) plus total invoice additional amount (136) plus total duty/tax/fee amount (176) plus or less adjustment amount (165))]]></xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="Tax">
		<xs:annotation>
			<xs:documentation>EDI: TAX</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="TaxRate">
					<xs:annotation>
						<xs:documentation>EDI: TAX.C243.5278 Rate (percentage) of the specified tax</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="MonetaryAmount"/>
				<xs:element name="TaxCategory" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: TAX.5305 Tax category code (G/S....)</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Type" use="required">
				<xs:annotation>
					<xs:documentation>EDI: TAX Tax type VAT = Value Added Tax</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="DocumentType">
		<xs:annotation>
			<xs:documentation>EDI: BGM.C002.1001 Document type code: 380 = Commercial invoice 381 = Credit Note 325 = Proforma Invoice</xs:documentation>
		</xs:annotation>
	</xs:element>
</xs:schema>