<?xml version="1.0" encoding="UTF-8"?><xs:schema elementFormDefault="qualified" xmlns:altova="http://www.altova.com/xml-schema-extensions" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="Invoice">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Header">
					<xs:annotation>
						<xs:documentation>General control data for this invoice.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="DocumentId">
					<xs:annotation>
						<xs:documentation>Identification information for this sales invoice.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="DocumentLanguage" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="LanguageCode"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element ref="FreeText" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Free text data realting to invoice header level.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="Location" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="Reference" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>EDI: RFF.C506.1154 References for invoice&apos;s header level.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="Party" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>EDI: NAD-segments Invoice partner information.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="Currency" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>EDI: CUX.C504.6345 Currency code to be used for invoicing purposes. Always ISO 4217 currency codes.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="TermsOfPayment" minOccurs="0"/>
				<xs:element ref="ModeOfTransport" minOccurs="0"/>
				<xs:element ref="TermsOfDelivery" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: TOD Terms of delivery data on invoice.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="Date" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="Percentage" minOccurs="0"/>
				<xs:element ref="Item" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>EDI: LIN Line items for purchase order</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="NumberOfLineItems">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="18"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element ref="AllowanceOrCharge" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="Tax" minOccurs="0"/>
				<xs:element ref="MonetaryAmount" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Header">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="SchemaId">
					<xs:annotation>
						<xs:documentation>EDI: UNH.S009.0065 Name of the message</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="SchemaVersion">
					<xs:annotation>
						<xs:documentation>EDI: UNH S009.0052 + S009.0054 Message version number</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="MessageFunction">
					<xs:annotation>
						<xs:documentation><![CDATA[EDI: BGM.1225 Defines if this message is, from the source system point of view, original message or it's change or cancellation: 9 = original, 5 = Message replacing a previous message, 1 = Cancellation. 53 = Test message. 31 = Copy, Indicates that the message is a copy of an original message that has been sent, e.g. for action or information.]]></xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element ref="DocumentType"/>
				<xs:element name="SourceSystem" type="xs:string">
					<xs:annotation>
						<xs:documentation>EDI: UNH.0068 The system originating the invoice : LASKURA LASKUHA METOCS</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="InterchangeSender" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: UNB.S002.0004 Technical identification, which partner has created this message. Usually OVT/EDI identifier.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="RecipientIdentification" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: UNB.S003.0004 Receiver&apos;s identification number.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="TransformToMedia" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The media format into which the broker must convert this message. Possible values: EDIFACT / NETINVOICE / XML / ELETTER / EMAIL / FAX / CSV</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="eInvoiceKey" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Key value used for electornic invoicing, describing the operator party and final address (e.g. TE003701082343)</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="MessageRoutingInbound" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation><![CDATA[This tag contains MQ queue references that are needed to determinate routing queues. Content can be created be the broker. Content will not be used by the receiving ERP system. Temporaty content, tag may be taken away on xslt parsing phases.]]></xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="MessageRoutingOutbound" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation><![CDATA[This tag contains MQ queue references that are needed to determinate routing queues. Content can be created be the broker. Content will not be used by the receiving ERP system. Temporaty content, tag may be taken away on xslt parsing phases.]]></xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="DocumentId">
		<xs:annotation>
			<xs:documentation>EDI: BGM Identification information</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="DocumentNo">
					<xs:annotation>
						<xs:documentation>EDI: BGM.C106.1004 Suppliers invoice number (e.g. 122-556204)</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element ref="Date">
					<xs:annotation>
						<xs:documentation>EDI: DTM.C507.2380 Invoice issue date.</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Party">
		<xs:annotation>
			<xs:documentation>EDI: NAD-segments Invoice partner information.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="PartyId" nillable="1" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>EDI: NAD.C082.3039 Identification information for party.</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:simpleContent>
							<xs:extension base="xs:string">
								<xs:attribute name="Type" use="required">
									<xs:annotation>
										<xs:documentation><![CDATA[EDI: NAD.C082.1131 VAT = VAT-code 91 = Assigned by Seller 92 = Assigned by Buyer 100 = OVT code 220 = Tax Party Code ZPL = Plant number/SAP ZTI = TilkkuID ZR3 = R/3-id/SAP ZZZ = Mutually defined]]></xs:documentation>
									</xs:annotation>
								</xs:attribute>
							</xs:extension>
						</xs:simpleContent>
					</xs:complexType>
				</xs:element>
				<xs:element name="PartyName1">
					<xs:annotation>
						<xs:documentation>EDI: NAD.C080.3036 Party Name part1</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="PartyName2" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.C080.3036 Party Name part2</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="PartyName3" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.C080.3036 Party Name part3</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="PartyName4" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.C080.3036 Party Name part4</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="PartyName5" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.C080.3036 Party Name part5</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="AddressLine1">
					<xs:annotation>
						<xs:documentation>EDI: NAD.C059.3042 Street or P.O. Box irformation row1.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="AddressLine2" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.C059.3042 Street or P.O. Box irformation row2.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="AddressLine3" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.C059.3042 Street or P.O. Box irformation row3.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="AddressLine4" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.C059.3042 Street or P.O. Box irformation row4.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="City" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.3164 Party&apos;s City name</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="PostalCode" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.3251 Zip code for party&apos;s address</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element ref="CountryCode"/>
				<xs:element ref="Contact" minOccurs="0" maxOccurs="5"/>
				<xs:element ref="BankAccount" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="Location" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="Role" use="required">
				<xs:annotation>
					<xs:documentation>EDI: NAD.3035 Partys role for invoice header: BY = Buyer SE = Seller ST = Ship To IV = Invoicee PE = Payee CN = Consignee MF =Manufacturer of goods</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="Contact">
		<xs:annotation>
			<xs:documentation>EDI: NAD.CTA Party related contact persons</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ContactId" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.CTA.C056.3413 Contact person&apos;s identification code (assigned by buyer) e.g. HR-number, department code</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="ContactName" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: NAD.CTA.C056.3412 Contact person&apos;s name</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="CommId" nillable="1" minOccurs="0" maxOccurs="5">
					<xs:annotation>
						<xs:documentation>EDI: NAD.CTA.COM.C076.3148 Contact persons communication information</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:simpleContent>
							<xs:extension base="xs:string">
								<xs:attribute name="Type">
									<xs:annotation>
										<xs:documentation>EDI: NAD.CTA.COM.C076.3155 TE = Telephone FX = Fax EM = email</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string"/>
									</xs:simpleType>
								</xs:attribute>
							</xs:extension>
						</xs:simpleContent>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Type">
				<xs:annotation>
					<xs:documentation>EDI: NAD.CTA.3139 SR = Sales representative PD = Purchasing contact AD = Accounting contact</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="TermsOfPayment">
		<xs:annotation>
			<xs:documentation>EDI: PAT Terms of payment</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="TermsOfPaymentCode" nillable="1" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: PAT.C110.4277 Terms of payment in coded format, as code</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:simpleContent>
							<xs:extension base="xs:string">
								<xs:attribute name="CodeSet" use="required">
									<xs:annotation>
										<xs:documentation>EDI: PAT.C110.3055 Code set issuer: 92 = Assigned by buyer 91 = Assigned by seller</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string"/>
									</xs:simpleType>
								</xs:attribute>
							</xs:extension>
						</xs:simpleContent>
					</xs:complexType>
				</xs:element>
				<xs:element name="TermsOfPaymentText" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: PAT.C110.4276 (both lines concatenated) Payment terms text</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element ref="Date" minOccurs="0"/>
				<xs:element ref="Percentage" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="Type" use="required">
				<xs:annotation>
					<xs:documentation>EDI: PAT.4279 1 = Basic</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="ModeOfTransport">
		<xs:annotation>
			<xs:documentation><![CDATA[EDI: TDT To specify information regarding the transport such as mode of transport, means of transport, its conveyance reference number and the identification of the means of transport.]]></xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ModeOfTransportCode" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: TDT.C220.8067 Mode of transport code (coded according to UN/ECE Recomm 19) 1 = Maritime 2 = Rail 3 = Road</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="ModeOfTransportText" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: TDT.C220.8066 Mode of delivery as text.</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="CarrierCode" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: TDT.C040.3127 Code for the trasport company.</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:attribute name="CodeSet" use="required">
							<xs:annotation>
								<xs:documentation>EDI: IMD.C273.3055 Code set issuer 92 = assigned by buyer 91 = assigned by seller</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:string"/>
							</xs:simpleType>
						</xs:attribute>
					</xs:complexType>
				</xs:element>
				<xs:element name="CarrierName" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: TDT.C040.3126 Name of the trasport company.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="TransportIdentification" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: TDT.C222.8212 Identification of transport means (i.e. ship code, registration number)</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Type" use="required">
				<xs:annotation>
					<xs:documentation>EDI: TDT.8051 Transport stage qualifier. 20 = main carriage</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="TermsOfDelivery">
		<xs:annotation>
			<xs:documentation>EDI: TOD Terms of delivery data for purchase order.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="TermsOfDeliveryCode" nillable="1" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: TOD.C100.4053 Terms of delivery code DDP, FCA...</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:simpleContent>
							<xs:extension base="xs:string">
								<xs:attribute name="CodeSet">
									<xs:annotation>
										<xs:documentation>EDI: TOD.C100.1131 Z2K = Incoterms 2000</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string"/>
									</xs:simpleType>
								</xs:attribute>
							</xs:extension>
						</xs:simpleContent>
					</xs:complexType>
				</xs:element>
				<xs:element name="TermsOfDeliveryText" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: TOD.C100.4052 (both fields concatenated) Terms of delivery in text format</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element ref="Location" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: TOD.LOC Location information for terms of delivery</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="DeliverySchedule" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: SCC.4493 Delivery schedule SC = Ship complete order</xs:documentation>
						<xs:appinfo>
							<altova:exampleValues>
								<altova:example value="SC"/>
							</altova:exampleValues>
						</xs:appinfo>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Type">
				<xs:annotation>
					<xs:documentation>EDI: TOD.4055 Terms of delivery function 4 = pick-up 6 = Delivery conditions</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="Location">
		<xs:annotation>
			<xs:documentation>EDI: LOC Location related information</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="LocationCode" nillable="1" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: LOC.C517.3225 Location in coded form</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:simpleContent>
							<xs:extension base="xs:string">
								<xs:attribute name="CodeSet" use="required">
									<xs:annotation>
										<xs:documentation>EDI: LOC.C517.3055 codeset issuer 91 = Assigned by Seller 92 = Assigned by Buyer UN = UN/ECE (United Nations - Economic Commission for Europe)</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string"/>
									</xs:simpleType>
								</xs:attribute>
							</xs:extension>
						</xs:simpleContent>
					</xs:complexType>
				</xs:element>
				<xs:element name="LocationText" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: TOD.LOC.C517.3224 Location for terms of delivery</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string"/>
					</xs:simpleType>
				</xs:element>
				<xs:element ref="CountryCode" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="Type" use="required">
				<xs:annotation>
					<xs:documentation><![CDATA[EDI: TOD.LOC.3227 1 = Place of terms of delivery 17 = Border crossing place 27 = Country of origin 28 = Country of destination of goods 39 = Country of production 76 = Original port of loading 105 = Place of consumption 181 = Registered office. Identifies the place or location of a registered office.]]></xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="Item">
		<xs:annotation>
			<xs:documentation>EDI: LIN Line item information</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="LineNo"/>
				<xs:element ref="ArticleNo" minOccurs="0">
					<xs:annotation>
						<xs:documentation>EDI: LIN.C212.7140 Line item&apos;s article numder.</xs:documentation>
					</xs:annotation>
