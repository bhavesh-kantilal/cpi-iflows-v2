<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:element name="COSMAS01">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="IDOC" type="COSMAS.COSMAS01"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:complexType name="COSMAS.COSMAS01">
		<xsd:annotation>
			<xsd:documentation>Master cost center</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="EDI_DC40" type="EDI_DC40.COSMAS.COSMAS01"/>
			<xsd:element maxOccurs="9999" name="E1CSKSM" type="COSMAS01.E1CSKSM"/>
		</xsd:sequence>
		<xsd:attribute fixed="1" name="BEGIN" type="xsd:string" use="required"/>
	</xsd:complexType>
	<xsd:complexType name="COSMAS01.E1CSKTM">
		<xsd:annotation>
			<xsd:documentation>Master cost center texts (CSKT)</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element minOccurs="0" name="MSGFN">
				<xsd:annotation>
					<xsd:documentation>Function</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="3"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element minOccurs="0" name="SPRAS">
				<xsd:annotation>
					<xsd:documentation>Language Key</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="1"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element minOccurs="0" name="KTEXT">
				<xsd:annotation>
					<xsd:documentation>General Name</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="20"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element minOccurs="0" name="LTEXT">
				<xsd:annotation>
					<xsd:documentation>Description</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="40"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element minOccurs="0" name="SPRAS_ISO">
				<xsd:annotation>
					<xsd:documentation>2-Character SAP Language Code</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="2"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
		<xsd:attribute fixed="1" name="SEGMENT" type="xsd:string" use="required"/>
	</xsd:complexType>
	<xsd:complexType name="COSMAS01.E1CSKSM">
