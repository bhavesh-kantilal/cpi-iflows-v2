<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<!-- Root element -->
	<xs:element name="root">
		<xs:complexType>
			<xs:sequence>
				<!-- row element containing mandatory string fields -->
				<xs:element name="row" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="IMAGE_FILE_NAME" type="xs:string"/>
							<xs:element name="IDENTITY" type="xs:string"/>
							<xs:element name="INVOICE_NO" type="xs:string"/>
							<xs:element name="INVOICE_DATE" type="xs:string"/>
							<xs:element name="DUE_DATE" type="xs:string"/>
							<xs:element name="PO_REFERENCE" type="xs:string"/>
							<xs:element name="RECEIPT_REF" type="xs:string"/>
							<xs:element name="INVOICE_RECIPIENT" type="xs:string"/>
							<xs:element name="GROSS_CURR_AMOUNT" type="xs:string"/>
							<xs:element name="VAT_CURR_AMOUNT" type="xs:string"/>
							<xs:element name="VAT_DOM_AMOUNT" type="xs:string"/>
							<xs:element name="CURRENCY" type="xs:string"/>
							<xs:element name="CURR_RATE" type="xs:string"/>
							<xs:element name="BANK_ACCOUNT" type="xs:string"/>
							<xs:element name="ASSOCIATION_NO" type="xs:string"/>
							<xs:element name="VAT_CODE" type="xs:string"/>
							<xs:element name="LABEL_NOTE" type="xs:string"/>
							<xs:element name="ARRIVAL_DATE" type="xs:string"/>
							<xs:element name="ITEM_TAX_PERCENTAGE" type="xs:string"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
