<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified"
           elementFormDefault="qualified"
           xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="root">
		<xs:complexType>
			<xs:sequence>
				<xs:element maxOccurs="unbounded"
				            name="CostCenter">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="erpSourceId"
							            type="xs:string"/>
							<xs:element name="externalSystemId"
							            type="xs:string"/>
							<xs:element name="isActive"
							            type="xs:boolean"/>
							<xs:element name="companyId"
							            type="xs:string"/>
							<xs:element name="dimensionName"
							            type="xs:string"/>
							<xs:element name="description"
							            type="xs:string"/>
							<xs:element name="Value"
							            type="xs:string"/>
							<xs:element name="usableInPurchase"
							            type="xs:boolean"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>