<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="root">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="correlationKey" type="xs:string"/>
				<xs:element name="invoice">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="documentId" type="xs:string"/>
							<xs:element name="importedOrderIdentifier" type="xs:string"/>									
							<xs:element name="balanceCodeString">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="dimensions"/>
										<xs:element name="amount" type="xs:string"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="companyExternalSystemId" type="xs:string"/>
							<xs:element name="companyId" type="xs:string"/>
							<xs:element name="companyName" type="xs:string"/>
							<xs:element maxOccurs="unbounded" name="companyIdentifiers">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="identifierType" type="xs:string"/>
										<xs:element name="identifierValue" type="xs:string"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="companyOrganizationNumber" type="xs:string"/>
							<xs:element name="currencyCode" type="xs:string"/>
							<xs:element name="customField_Text1" type="xs:string"/>	
							<xs:element name="customField_Text2" type="xs:string"/>	
							<xs:element name="customField_Text5" type="xs:string"/>	
							<xs:element name="customField_DateTime5" minOccurs="0" type="xs:string"/>	
							<xs:element name="currencyExternalSystemId" type="xs:string"/>
							<xs:element name="currencyRate" type="xs:string"/>
							<xs:element name="isCurrencyRateImported" type="xs:string"/>
							<xs:element name="hasCrossCompanyPostings" type="xs:string"/>
							<xs:element name="originalDocumentType" type="xs:string"/>
							<xs:element name="dueDate" type="xs:dateTime"/>
							<xs:element name="finalBookingDate" type="xs:dateTime"/>
							<xs:element name="imagePath" type="xs:string"/>
							<xs:element name="documentURL" type="xs:string"/>
							<xs:element name="invoiceDate" type="xs:dateTime"/>
							<xs:element name="invoiceNumber" type="xs:string"/>
							<xs:element name="netAmount" type="xs:string"/>
							<xs:element name="paymentTerm" type="xs:string"/>
							<xs:element name="preferredPaymentDate" type="xs:dateTime"/>
							<xs:element name="preliminaryBookingDate" type="xs:dateTime"/>
							<xs:element name="preliminaryVoucherNumber"/>
							<xs:element name="finalVoucherNumber"/>
							<xs:element name="roundingAmount" type="xs:string"/>
							<xs:element name="supplierExternalSystemId" type="xs:string"/>
							<xs:element name="supplierId" type="xs:unsignedInt"/>
							<xs:element maxOccurs="unbounded" name="supplierIdentifiers">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="identifierType" type="xs:string"/>
										<xs:element name="identifierValue" type="xs:string"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="supplierName" type="xs:string"/>
							<xs:element name="invoiceReference" type="xs:string"/>
							<xs:element name="referencedDocuments"/>
							<xs:element name="taxAmount" type="xs:string"/>
							<xs:element name="supplierTaxIndicator1" type="xs:string"/>
							<xs:element name="totalAmount" type="xs:string"/>
							<xs:element name="totalCodedNetAmount" type="xs:string"/>
							<xs:element name="totalCodedTaxAmount" type="xs:string"/>
							<xs:element name="invoiceLines">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="amount" type="xs:string"/>
										<xs:element name="lineNumber" type="xs:string"/>
										<xs:element name="quantity" type="xs:string"/>
										<xs:element name="quantityUnit" type="xs:string"/>
										<xs:element name="unitPrice" type="xs:string"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="codingLines">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="companyId" type="xs:string"/>
										<xs:element name="companyExternalSystemId" type="xs:string"/>
										<xs:element name="dimensions">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="dimension1" type="xs:unsignedShort"/>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element name="amount" type="xs:string"/>
										<xs:element name="grossAmount" type="xs:string"/>
										<xs:element name="invoiceLineNumber" type="xs:string"/>
										<xs:element name="codingLineNumber" type="xs:string"/>
										<xs:element name="taxIndicator1" type="xs:string"/>
										<xs:element name="isEnabled" type="xs:string"/>
										<xs:element name="tag" type="xs:string"/>
										<xs:element name="poConnectionLineNumbers" type="xs:string"/>
										<xs:element name="lastApproverFirstName" type="xs:string"/>
										<xs:element name="lastApproverLastName"/>
										<xs:element name="lastApproverUserName" type="xs:string"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="taxLines">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="dimensions" type="xs:string"/>
										<xs:element name="amount" type="xs:string"/>
										<xs:element name="netAmount" type="xs:string"/>
										<xs:element name="grossAmount" type="xs:string"/>
										<xs:element name="codingLineNumber" type="xs:string"/>
										<xs:element name="deductiblePercentage" type="xs:string"/>
										<xs:element name="percentage" type="xs:string"/>
										<xs:element name="taxCode" type="xs:string"/>
										<xs:element name="taxLineNumber" type="xs:string"/>
										<xs:element name="taxIndicator1" type="xs:string"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="isPaymentBlocked" type="xs:string"/>
							<xs:element name="erpId" type="xs:string"/>
							<xs:element name="receivedDate" type="xs:string"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="tag" type="xs:string"/>
			</xs:sequence>
		</xs:complexType>
