        <bpmn2:callActivity id="CallActivity_404958" name="Form Email Attachment Body">
            <bpmn2:extensionElements>
                <ifl:property>
                    <key>bodyType</key>
                    <value>expression</value>
                </ifl:property>
                <ifl:property>
                    <key>propertyTable</key>
                    <value/>
                </ifl:property>
                <ifl:property>
                    <key>headerTable</key>
                    <value>&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;expression&lt;/cell&gt;&lt;cell id='Value'&gt;${property.CH_Medius_DocumentId}_${property.CH_Medius_InvoiceNumber}_${property.CH_Medius_MessageNumber}.zip&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;Mail_AttachmentName&lt;/cell&gt;&lt;cell id='Datatype'&gt;String&lt;/cell&gt;&lt;/row&gt;&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;expression&lt;/cell&gt;&lt;cell id='Value'&gt;Medius Invoice Posting Failed to GSAP ${property.CH_Medius_DocumentId} ${property.CH_Medius_InvoiceNumber} ${property.CH_Medius_MessageNumber}&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;Mail_Subject&lt;/cell&gt;&lt;cell id='Datatype'&gt;String&lt;/cell&gt;&lt;/row&gt;&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;constant&lt;/cell&gt;&lt;cell id='Value'&gt;{{Mail_CC}}&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;Mail_CC&lt;/cell&gt;&lt;cell id='Datatype'&gt;&lt;/cell&gt;&lt;/row&gt;&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;constant&lt;/cell&gt;&lt;cell id='Value'&gt;{{Mail_To}}&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;Mail_To&lt;/cell&gt;&lt;cell id='Datatype'&gt;&lt;/cell&gt;&lt;/row&gt;</value>
                </ifl:property>
                <ifl:property>
                    <key>wrapContent</key>
                    <value>&lt;root&gt;
	&lt;body&gt;&lt;![CDATA[
	&lt;!DOCTYPE html&gt;
&lt;html&gt;
&lt;head&gt;
  &lt;meta charset="UTF-8"&gt;
  &lt;title&gt;Medius Invoice Failure Notification&lt;/title&gt;
&lt;/head&gt;
&lt;body style="font-family: Arial, sans-serif; line-height: 1.6;"&gt;
  &lt;p&gt;
    Medius Invoice Posting to GSAP Has Failed.&lt;br&gt;
    Below are the details of the Invoice and attached is the Payloads.
  &lt;/p&gt;
  &lt;p&gt;
    If you need to raise a ticket to GSAP, please ensure the attachment of this email is also provided in the ticket to allow for efficient troubleshooting.
  &lt;/p&gt;
  &lt;ul&gt;
    &lt;li&gt;&lt;strong&gt;Medius_DocumentId&lt;/strong&gt;: ${property.CH_Medius_DocumentId}&lt;/li&gt;
    &lt;li&gt;&lt;strong&gt;Medius_InvoiceNumber&lt;/strong&gt;: ${property.CH_Medius_InvoiceNumber}&lt;/li&gt;
    &lt;li&gt;&lt;strong&gt;Medius_MessageNumber&lt;/strong&gt;: ${property.CH_Medius_MessageNumber}&lt;/li&gt;
	 &lt;li&gt;&lt;strong&gt;InvoicePostingError&lt;/strong&gt;: ${property.CH_Invoice_Error}&lt;/li&gt;
  &lt;/ul&gt;
&lt;/body&gt;
&lt;/html&gt;
	
	 ]]&gt;&lt;/body&gt;
	&lt;attachments&gt;		
		&lt;attachment&gt;
			&lt;content&gt;&lt;![CDATA[${property.BAPIRequest}]]&gt;&lt;/content&gt;
			&lt;name&gt;BAPIRequest.xml&lt;/name&gt;
			&lt;type&gt;application/xml&lt;/type&gt;
		&lt;/attachment&gt;
		&lt;attachment&gt;
			&lt;content&gt;&lt;![CDATA[${property.BAPIResponse}]]&gt;&lt;/content&gt;
			&lt;name&gt;BAPIResponse.xml&lt;/name&gt;
			&lt;type&gt;application/xml&lt;/type&gt;
		&lt;/attachment&gt;
	&lt;/attachments&gt;
&lt;/root&gt;</value>
                </ifl:property>
                <ifl:property>
                    <key>componentVersion</key>
                    <value>1.6</value>
