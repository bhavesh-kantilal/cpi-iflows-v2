<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

  <!-- Root -->
  <xs:element name="DocumentInfoRecordUpdateRequest" type="DocumentInfoRecordUpdateRequestType"/>

  <xs:complexType name="DocumentInfoRecordUpdateRequestType">
    <xs:sequence>
      <xs:element name="MessageId"          type="xs:string" minOccurs="1"/>
      <xs:element name="DocType"            type="xs:string" minOccurs="1"/>
      <xs:element name="DocVersion"         type="xs:string" minOccurs="1"/>
      <xs:element name="DocPart"            type="xs:string" minOccurs="1"/>
      <xs:element name="DocumentInfoRecord" type="xs:string" minOccurs="1"/>
      <xs:element name="Status"             type="xs:string" minOccurs="1"/>
      <xs:element name="Descriptions"       type="DescriptionsType"     minOccurs="0"/>
      <xs:element name="Links"              type="LinksType"            minOccurs="0"/>
      <xs:element name="Relations"          type="RelationsType"        minOccurs="0"/>
      <xs:element name="Characteristics"    type="CharacteristicsType"  minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Descriptions -->
  <xs:complexType name="DescriptionsType">
    <xs:sequence>
      <xs:element name="Description" type="LanguageDescriptionType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="LanguageDescriptionType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="lang" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- Links -->
  <xs:complexType name="LinksType">
    <xs:sequence>
      <xs:element name="Link" type="LinkType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="LinkType">
    <xs:sequence>
      <xs:element name="URL"         type="xs:string" minOccurs="1"/>
      <xs:element name="Description" type="xs:string" minOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Relations (object links) -->
  <xs:complexType name="RelationsType">
    <xs:sequence>
      <xs:element name="Relation" type="RelationType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="RelationType">
    <xs:sequence>
      <xs:element name="Type"        type="xs:string" minOccurs="1"/>
      <xs:element name="Id"          type="xs:string" minOccurs="1"/>
      <xs:element name="TechnicalId" type="xs:string" minOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Characteristics (classification) -->
  <xs:complexType name="CharacteristicsType">
    <xs:sequence>
      <xs:element name="Characteristic" type="CharacteristicType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CharacteristicType">
    <xs:sequence>
      <xs:element name="Id"    type="xs:string" minOccurs="1"/>
      <xs:element name="Value" type="xs:string" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
